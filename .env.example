# انسخ هذا الملف إلى .env وعدّل القيم
# مفتاح سري عشوائي طويل: python3 -c "import secrets; print(secrets.token_hex(32))"
CC_SECRET_KEY=change-me
CC_PLATFORM_NAME=عزم
CC_COMPANY_NAME=الإنماء الحر للمقاولات
# مدة الخمول قبل انتهاء الجلسة (بالدقائق) والحد الأقصى لعمر الجلسة (بالساعات)
CC_SESSION_IDLE_MINUTES=120
CC_SESSION_ABSOLUTE_HOURS=12
# 1 في التشغيل الفعلي مع HTTPS. اجعله 0 فقط للتجربة المحلية بدون HTTPS
CC_COOKIE_SECURE=1
# 1 عند التشغيل خلف nginx (يعرض IP المستخدم الحقيقي في السجل)
CC_BEHIND_PROXY=1
